@page "/session/register-user"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@using TaskManager.Application.DTO.DTO.Identity
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Registrar nuevo usuario</PageTitle>

<div class="min-vh-100 d-flex align-items-center py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="card border-0 shadow-2xl" style="border-radius: 20px; backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.95);">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <div class="mb-3">
                                <div class="mx-auto d-flex align-items-center justify-content-center"
                                     style="width: 80px; height: 80px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 20px;">
                                    <i class="fas fa-user-plus text-white fs-2"></i>
                                </div>
                            </div>
                            <h2 class="fw-bold mb-2" style="color: #2d3748;">Registrar Usuario</h2>
                            <p class="text-muted">Crear nueva cuenta de usuario interno</p>
                        </div>

                        <EditForm Model="registerUserDto" OnValidSubmit="HandleRegister" class="needs-validation" novalidate>
                            <DataAnnotationsValidator />

                            <!-- Nombre completo -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-user me-2" style="color: #667eea;"></i>
                                    Nombre completo
                                </label>
                                <div class="input-group">
                                    <InputText @bind-Value="registerUserDto.FullName"
                                               class="form-control form-control-lg border-2"
                                               style="border-radius: 12px 0 0 12px; border-color: #e2e8f0;"
                                               placeholder="Ingresa tu nombre completo" />
                                    <span class="input-group-text border-2 border-start-0"
                                          style="border-radius: 0 12px 12px 0; border-color: #e2e8f0; background: #f8fafc;">
                                        <i class="fas fa-check text-success" style="display: @(IsFieldValid("FullName") ? "block" : "none")"></i>
                                    </span>
                                </div>
                                <ValidationMessage For="@(() => registerUserDto.FullName)" class="text-danger small mt-1" />
                            </div>

                            <!-- Email -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-envelope me-2" style="color: #667eea;"></i>
                                    Correo electrónico
                                </label>
                                <div class="input-group">
                                    <InputText @bind-Value="registerUserDto.Email"
                                               type="email"
                                               class="form-control form-control-lg border-2"
                                               style="border-radius: 12px 0 0 12px; border-color: #e2e8f0;"
                                               placeholder="ejemplo@empresa.com" />
                                    <span class="input-group-text border-2 border-start-0"
                                          style="border-radius: 0 12px 12px 0; border-color: #e2e8f0; background: #f8fafc;">
                                        <i class="fas fa-check text-success" style="display: @(IsFieldValid("Email") ? "block" : "none")"></i>
                                    </span>
                                </div>
                                <ValidationMessage For="@(() => registerUserDto.Email)" class="text-danger small mt-1" />
                            </div>

                            <!-- Contraseña -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-lock me-2" style="color: #667eea;"></i>
                                    Contraseña
                                </label>
                                <div class="input-group">
                                    <InputText @bind-Value="registerUserDto.Password"
                                               type="@(showPassword ? "text" : "password")"
                                               class="form-control form-control-lg border-2"
                                               style="border-radius: 12px 0 0 12px; border-color: #e2e8f0;"
                                               placeholder="Mínimo 6 caracteres" />
                                    <button class="btn border-2 border-start-0"
                                            type="button"
                                            style="border-radius: 0 12px 12px 0; border-color: #e2e8f0; background: #f8fafc;"
                                            @onclick="TogglePasswordVisibility">
                                        <i class="fas @(showPassword ? "fa-eye-slash" : "fa-eye")" style="color: #64748b;"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => registerUserDto.Password)" class="text-danger small mt-1" />

                                <!-- Password strength indicator -->
                                @if (!string.IsNullOrEmpty(registerUserDto.Password))
                                {
                                    <div class="mt-2">
                                        <div class="d-flex align-items-center">
                                            <div class="flex-grow-1 me-2">
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar @GetPasswordStrengthClass()"
                                                         style="width: @(GetPasswordStrength())%"></div>
                                                </div>
                                            </div>
                                            <small class="@GetPasswordStrengthTextClass()">@GetPasswordStrengthText()</small>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Rol -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark">
                                    <i class="fas fa-user-tag me-2" style="color: #667eea;"></i>
                                    Rol <small class="text-muted">(opcional)</small>
                                </label>
                                <InputSelect @bind-Value="registerUserDto.Role"
                                             class="form-select form-select-lg border-2"
                                             style="border-radius: 12px; border-color: #e2e8f0;">
                                    <option value="">Seleccionar rol...</option>
                                    <option value="Admin">Administrador</option>
                                    <option value="Manager">Usuario</option>
                                    <option value="Supervisor">Supervisor</option>
                                    <option value="Asesor">Asesor</option>
                                    <option value="Auditor">Auditor</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                            </div>

                            <!-- Botones -->
                            <div class="d-grid gap-3 mt-4">
                                <button type="submit"
                                        class="btn btn-lg fw-semibold position-relative overflow-hidden"
                                        style="background: linear-gradient(135deg, #667eea, #764ba2); border: none; border-radius: 12px; padding: 15px;"
                                        disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Registrando...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-plus me-2"></i>
                                        <span>Registrar Usuario</span>
                                    }
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary btn-lg fw-semibold"
                                        style="border-radius: 12px; padding: 15px; border-width: 2px;"
                                        @onclick="HandleCancel"
                                        disabled="@isSubmitting">
                                    <i class="fas fa-times me-2"></i>
                                    Cancelar
                                </button>
                            </div>
                        </EditForm>

                        <!-- Mensajes de estado -->
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-4 border-0" style="border-radius: 12px; background: rgba(220, 53, 69, 0.1);">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                @errorMessage
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(showSuccessMessage))
                        {
                            <div class="alert alert-success mt-4 border-0" style="border-radius: 12px; background: rgba(25, 135, 84, 0.1);">
                                <i class="fas fa-check-circle me-2"></i>
                                @showSuccessMessage
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

@code {
    private RegisterUserDTO registerUserDto = new();
    private string errorMessage = string.Empty;
    private string? showSuccessMessage;
    private bool SuccessMessage = false;
    private bool isSubmitting = false;
    private bool showPassword = false;
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            var url = new Uri(Navigation.BaseUri + "api/account/register");

            var response = await Http.PostAsJsonAsync(url, registerUserDto);

            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("Swal.fire", new
                {
                    title = "¡Registro exitoso!",
                    text = "El usuario fue creado correctamente.",
                    icon = "success",
                    confirmButtonText = "OK"
                });

                await Task.Delay(2000);
                Navigation.NavigateTo("/home", true);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = error;

                await JSRuntime.InvokeVoidAsync("Swal.fire", new
                {
                    title = "Error",
                    text = errorMessage,
                    icon = "error",
                    confirmButtonText = "Cerrar"
                });
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error interno del servidor: " + ex.Message;

            await JSRuntime.InvokeVoidAsync("Swal.fire", new
            {
                title = "Error interno",
                text = errorMessage,
                icon = "error",
                confirmButtonText = "Cerrar"
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private bool ValidateForm()
    {
        var isValid = true;

        if (string.IsNullOrWhiteSpace(registerUserDto.FullName))
        {
            errorMessage = "El nombre completo es obligatorio.";
            isValid = false;
        }
        else if (string.IsNullOrWhiteSpace(registerUserDto.Email))
        {
            errorMessage = "El correo electrónico es obligatorio.";
            isValid = false;
        }
        else if (!IsValidEmail(registerUserDto.Email))
        {
            errorMessage = "El formato del correo electrónico no es válido.";
            isValid = false;
        }
        else if (string.IsNullOrWhiteSpace(registerUserDto.Password))
        {
            errorMessage = "La contraseña es obligatoria.";
            isValid = false;
        }
        else if (registerUserDto.Password.Length < 6)
        {
            errorMessage = "La contraseña debe tener al menos 6 caracteres.";
            isValid = false;
        }

        return isValid;
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private bool IsFieldValid(string fieldName)
    {
        return fieldName switch
        {
            "FullName" => !string.IsNullOrWhiteSpace(registerUserDto.FullName),
            "Email" => !string.IsNullOrWhiteSpace(registerUserDto.Email) && IsValidEmail(registerUserDto.Email),
            _ => false
        };
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private int GetPasswordStrength()
    {
        if (string.IsNullOrEmpty(registerUserDto.Password)) return 0;

        int strength = 0;
        if (registerUserDto.Password.Length >= 6) strength += 25;
        if (registerUserDto.Password.Length >= 8) strength += 25;
        if (registerUserDto.Password.Any(char.IsDigit)) strength += 25;
        if (registerUserDto.Password.Any(c => !char.IsLetterOrDigit(c))) strength += 25;

        return strength;
    }

    private string GetPasswordStrengthClass()
    {
        var strength = GetPasswordStrength();
        return strength switch
        {
            <= 25 => "bg-danger",
            <= 50 => "bg-warning",
            <= 75 => "bg-info",
            _ => "bg-success"
        };
    }

    private string GetPasswordStrengthTextClass()
    {
        var strength = GetPasswordStrength();
        return strength switch
        {
            <= 25 => "text-danger",
            <= 50 => "text-warning",
            <= 75 => "text-info",
            _ => "text-success"
        };
    }

    private string GetPasswordStrengthText()
    {
        var strength = GetPasswordStrength();
        return strength switch
        {
            <= 25 => "Débil",
            <= 50 => "Regular",
            <= 75 => "Buena",
            _ => "Fuerte"
        };
    }

    private async Task HandleCancel()
    {
        if (isSubmitting) return;

        Navigation.NavigateTo("/home");
    }

}