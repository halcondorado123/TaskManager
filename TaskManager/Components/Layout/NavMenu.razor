@using Microsoft.EntityFrameworkCore.Metadata.Internal
@inject HttpClient Http
@inject NavigationManager Navigation


@using static System.Net.WebRequestMethods
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TaskManager</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/session/register-user" Match="NavLinkMatch.All">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Registrar
            </NavLink>
        </div>


        <div class="flex-grow-1"></div>

        <div class="nav-item px-3 text-center mb-3">
            <button class="btn btn-outline-danger btn-sm w-75" @onclick="HandleLogout" title="Cerrar sesión">
                <i class="fas fa-sign-out-alt me-1"></i> Cerrar sesión
            </button>
        </div>

    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        await Http.PostAsync("api/account/logout", null);
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}